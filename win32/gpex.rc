/****************************************************************************
 *  Genesis Plus EX -- Win32 GUI frontend
 *
 *  gpex.rc -- menu, accelerator table, dialogs, icon and version info.
 ****************************************************************************/

#include <windows.h>
#include "resource.h"

/****************************************************************************
 * Icon and manifest
 ****************************************************************************/

IDI_APPICON ICON "gpex.ico"

1 RT_MANIFEST "gpex.manifest"
IDR_PADIMG RCDATA "pad.bin"
IDR_RING RCDATA "ring_png.png"
IDR_RINGBLINK RCDATA "ring_gif.gif"
IDR_LOGO RCDATA "logo_gpex.png"
IDR_GENRES RCDATA "genres.bin"
IDR_SEGA_SFX RCDATA "sega.wav"
IDR_RING_SFX RCDATA "ring_sfx.wav"

/****************************************************************************
 * Menu
 ****************************************************************************/

IDR_MAINMENU MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&Open ROM...\tCtrl+O",            IDM_FILE_OPEN
    MENUITEM "ROM &Directory...\tCtrl+R",        IDM_FILE_BROWSER
    POPUP "&Recent Files"
    BEGIN
      MENUITEM "(Empty)",                       IDM_FILE_RECENT_BASE, GRAYED
    END
    MENUITEM "ROM &Information...",             IDM_FILE_ROMINFO
    MENUITEM "Insert Dis&c...",             IDM_EMU_INSERTDISC
    MENUITEM "Appl&y Patch...",                 IDM_FILE_APPLYPATCH
    MENUITEM SEPARATOR
    MENUITEM "Open Genesis Plus EX &Folder", IDM_FILE_OPENDIR
    MENUITEM SEPARATOR
    MENUITEM "E&xit",                           IDM_FILE_EXIT
  END

  POPUP "&Emulation"
  BEGIN
    MENUITEM "&Pause\tF2 / Pause",              IDM_EMU_PAUSE
    MENUITEM "S&top\tF3",                       IDM_EMU_STOP
    MENUITEM "&Reset\tF4",                  IDM_EMU_RESET
    MENUITEM "&Hard Reset\tCtrl+F4",       IDM_EMU_HARDRESET
    MENUITEM SEPARATOR
    POPUP "&Load State"
    BEGIN
      MENUITEM "Load State from &Selected Slot\tF8", IDM_FILE_LOADSTATE
      POPUP "Load State from S&lot"
      BEGIN
        MENUITEM "Slot &0",                 IDM_FILE_LOADSLOT_BASE + 0
        MENUITEM "Slot &1",                 IDM_FILE_LOADSLOT_BASE + 1
        MENUITEM "Slot &2",                 IDM_FILE_LOADSLOT_BASE + 2
        MENUITEM "Slot &3",                 IDM_FILE_LOADSLOT_BASE + 3
        MENUITEM "Slot &4",                 IDM_FILE_LOADSLOT_BASE + 4
        MENUITEM "Slot &5",                 IDM_FILE_LOADSLOT_BASE + 5
        MENUITEM "Slot &6",                 IDM_FILE_LOADSLOT_BASE + 6
        MENUITEM "Slot &7",                 IDM_FILE_LOADSLOT_BASE + 7
        MENUITEM "Slot &8",                 IDM_FILE_LOADSLOT_BASE + 8
        MENUITEM "Slot &9",                 IDM_FILE_LOADSLOT_BASE + 9
      END
      MENUITEM "Load State from &File...",   IDM_FILE_LOADSTATEFILE
      POPUP "Load &Backup State"
      BEGIN
        MENUITEM "&Newest",                 IDM_FILE_LOADBACKUP_BASE + 0
        MENUITEM "&Second Newest",          IDM_FILE_LOADBACKUP_BASE + 1
        MENUITEM "&Third Newest",           IDM_FILE_LOADBACKUP_BASE + 2
      END
      MENUITEM "&Undo Load State\tCtrl+F8",           IDM_EMU_UNDOLOAD
    END
    POPUP "&Save State"
    BEGIN
      MENUITEM "Save State to &Selected Slot\tF5", IDM_FILE_SAVESTATE
      POPUP "Save State to S&lot"
      BEGIN
        MENUITEM "Slot &0",                 IDM_FILE_SAVESLOT_BASE + 0
        MENUITEM "Slot &1",                 IDM_FILE_SAVESLOT_BASE + 1
        MENUITEM "Slot &2",                 IDM_FILE_SAVESLOT_BASE + 2
        MENUITEM "Slot &3",                 IDM_FILE_SAVESLOT_BASE + 3
        MENUITEM "Slot &4",                 IDM_FILE_SAVESLOT_BASE + 4
        MENUITEM "Slot &5",                 IDM_FILE_SAVESLOT_BASE + 5
        MENUITEM "Slot &6",                 IDM_FILE_SAVESLOT_BASE + 6
        MENUITEM "Slot &7",                 IDM_FILE_SAVESLOT_BASE + 7
        MENUITEM "Slot &8",                 IDM_FILE_SAVESLOT_BASE + 8
        MENUITEM "Slot &9",                 IDM_FILE_SAVESLOT_BASE + 9
      END
      MENUITEM "Save State to &File...",     IDM_FILE_SAVESTATEFILE
      MENUITEM "&Undo Save State\tCtrl+F5",               IDM_EMU_UNDOSAVE
    END
    POPUP "Select State Sl&ot"
    BEGIN
      MENUITEM "Slot &0",                 IDM_FILE_SLOT_BASE + 0
      MENUITEM "Slot &1",                 IDM_FILE_SLOT_BASE + 1
      MENUITEM "Slot &2",                 IDM_FILE_SLOT_BASE + 2
      MENUITEM "Slot &3",                 IDM_FILE_SLOT_BASE + 3
      MENUITEM "Slot &4",                 IDM_FILE_SLOT_BASE + 4
      MENUITEM "Slot &5",                 IDM_FILE_SLOT_BASE + 5
      MENUITEM "Slot &6",                 IDM_FILE_SLOT_BASE + 6
      MENUITEM "Slot &7",                 IDM_FILE_SLOT_BASE + 7
      MENUITEM "Slot &8",                 IDM_FILE_SLOT_BASE + 8
      MENUITEM "Slot &9",                 IDM_FILE_SLOT_BASE + 9
    END
    MENUITEM "&Manage States...",                IDM_FILE_STATEMGR
    MENUITEM SEPARATOR
    MENUITEM "&Fast Forward\tTab",              IDM_EMU_FASTFWD
    MENUITEM "Rewin&d\tBackspace",              IDM_EMU_REWINDNOW
    POPUP "Game S&peed"
    BEGIN
      MENUITEM "&Slower\tCtrl+-",              IDM_EMU_SPEEDDOWN
      MENUITEM "&Normal (100%)\tCtrl+0",       IDM_EMU_SPEEDRESET
      MENUITEM "&Faster\tCtrl++",              IDM_EMU_SPEEDUP
    END
    MENUITEM SEPARATOR
    MENUITEM "A&uto Resume",                    IDM_EMU_AUTOSAVE
    MENUITEM "Pause When &Inactive",            IDM_EMU_PAUSE_UNFOCUSED
  END

  POPUP "&View"
  BEGIN
    POPUP "&View Mode"
    BEGIN
      MENUITEM "&List View",                    IDM_VIEW_LIST
      MENUITEM "&Grid View",                    IDM_VIEW_GRID
      MENUITEM SEPARATOR
      POPUP "Grid &Size"
      BEGIN
        MENUITEM "&Tiny",                       IDM_SET_COVERSIZE_BASE + 0
        MENUITEM "E&xtra Small",                IDM_SET_COVERSIZE_BASE + 1
        MENUITEM "&Small",                      IDM_SET_COVERSIZE_BASE + 2
        MENUITEM "&Medium",                     IDM_SET_COVERSIZE_BASE + 3
        MENUITEM "Me&dium Large",               IDM_SET_COVERSIZE_BASE + 4
        MENUITEM "&Large",                      IDM_SET_COVERSIZE_BASE + 5
        MENUITEM "Extra L&arge",                IDM_SET_COVERSIZE_BASE + 6
      END
    END
    POPUP "St&yle"
    BEGIN
      MENUITEM "&Classic",                      IDM_SET_STYLE_BASE + 0
      MENUITEM "&Modern",                       IDM_SET_STYLE_BASE + 1
    END
    POPUP "&Theme"
    BEGIN
      MENUITEM "&System",                       IDM_VIDEO_THEME_BASE + 0
      MENUITEM "&Light",                        IDM_VIDEO_THEME_BASE + 1
      MENUITEM "&Dark",                         IDM_VIDEO_THEME_BASE + 2
    END
    MENUITEM SEPARATOR
    POPUP "Tool&bars"
    BEGIN
      MENUITEM "Show To&olbar",                   IDM_VIEW_TOOLBAR
      MENUITEM "Show Toolbar &Labels",            IDM_OPT_TBLABELS
      POPUP "Toolbar Si&ze"
      BEGIN
        MENUITEM "&Small",                        IDM_SET_TBSIZE_BASE + 0
        MENUITEM "&Normal",                       IDM_SET_TBSIZE_BASE + 1
        MENUITEM "&Large",                        IDM_SET_TBSIZE_BASE + 2
      END
      MENUITEM "Toolbar in Full&screen",          IDM_VIEW_FSTOOLBAR
      MENUITEM "Show S&earch Bar",                IDM_VIEW_SEARCHBAR
      MENUITEM "Show F&ilter Bar",                IDM_VIEW_FILTERBAR
      MENUITEM "Show Stat&us Bar",                IDM_VIEW_STATUSBAR
    END
    POPUP "Game &List"
    BEGIN
      POPUP "&List Spacing"
      BEGIN
        MENUITEM "&Compact",                      IDM_VIEW_DENSITY_BASE + 0
        MENUITEM "&Normal",                       IDM_VIEW_DENSITY_BASE + 1
        MENUITEM "&Expanded",                     IDM_VIEW_DENSITY_BASE + 2
      END
      POPUP "List &Columns"
      BEGIN
        MENUITEM "&Favorite",                     IDM_VIEW_COL_FAV
        MENUITEM "&Name",                         IDM_VIEW_COL_BASE + 0
        MENUITEM "&Console",                      IDM_VIEW_COL_BASE + 1
        MENUITEM "&Genre",                        IDM_VIEW_COL_EXTRA + 0
        MENUITEM "&Region",                       IDM_VIEW_COL_EXTRA + 1
        MENUITEM "File &Size",                    IDM_VIEW_COL_EXTRA + 2
        MENUITEM "File &Type",                    IDM_VIEW_COL_EXTRA + 3
      END
      MENUITEM SEPARATOR
      MENUITEM "Show &Favorites Only",            IDM_VIEW_FAVONLY
      MENUITEM "Show &Recently Played",           IDM_VIEW_SORT_RECENT
      MENUITEM "Clean Game &Names",               IDM_VIEW_CLEANNAMES
      MENUITEM "Show &Grid Lines",                IDM_VIEW_GRIDLINES
      MENUITEM "Group by Consol&e",               IDM_VIEW_GROUPCONSOLE
      MENUITEM "Show &A-Z Strip",                 IDM_VIEW_AZSTRIP
    END
    MENUITEM SEPARATOR
    MENUITEM "Always on &Top",                  IDM_VIDEO_ALWAYS_ON_TOP
    MENUITEM "Reset &Window Size",              IDM_VIEW_RESETWINDOW
  END

  POPUP "&Video"
  BEGIN
    POPUP "Window &Size"
    BEGIN
      MENUITEM "1x",                            IDM_VIDEO_SCALE_BASE + 0
      MENUITEM "2x",                            IDM_VIDEO_SCALE_BASE + 1
      MENUITEM "3x",                            IDM_VIDEO_SCALE_BASE + 2
      MENUITEM "4x",                            IDM_VIDEO_SCALE_BASE + 3
      MENUITEM "5x",                            IDM_VIDEO_SCALE_BASE + 4
      MENUITEM "6x",                            IDM_VIDEO_SCALE_BASE + 5
    END
    MENUITEM "&Fullscreen\tAlt+Enter",          IDM_VIDEO_FULLSCREEN
    MENUITEM SEPARATOR
    POPUP "Render Fi&lter"
    BEGIN
      MENUITEM "None",                          IDM_VIDEO_FILTER_NONE
    END
#ifdef _WIN64   /* librashader has no 32-bit build */
    POPUP "Sha&ders"
    BEGIN
      MENUITEM "None",                          IDM_VIDEO_SHADER_NONE
      MENUITEM "Preset...",                     IDM_VIDEO_SHADER_PRESET
      MENUITEM SEPARATOR
      MENUITEM "Shader &Parameters...",         IDM_VIDEO_SHADERPARAMS
      MENUITEM "&Skip Render Filter with Shaders", IDM_VIDEO_SHADERNOFILTER
    END
#endif
    POPUP "Visual &Effects"
    BEGIN
      MENUITEM "&Smooth Scaling",               IDM_VIDEO_SMOOTH
      MENUITEM "&Dither Smoothing",             IDM_VIDEO_DITHER
      MENUITEM "&Integer Scaling",              IDM_VIDEO_INTSCALE
      MENUITEM "&Flicker Blending",             IDM_VIDEO_FLICKER
      MENUITEM "&Brighten",                     IDM_VIDEO_BRIGHTEN
      POPUP "LCD &Ghosting"
      BEGIN
        MENUITEM "Off",                         IDM_VIDEO_LCD_BASE + 0
        MENUITEM "Light",                       IDM_VIDEO_LCD_BASE + 1
        MENUITEM "Medium",                      IDM_VIDEO_LCD_BASE + 2
        MENUITEM "Heavy",                       IDM_VIDEO_LCD_BASE + 3
      END
    END
    MENUITEM "Picture Ad&justments...",         IDM_VIDEO_PICTUREADJ
    POPUP "Sc&anlines"
    BEGIN
      MENUITEM "Off",                           IDM_VIDEO_SCANLINE_BASE + 0
      MENUITEM "25%",                           IDM_VIDEO_SCANLINE_BASE + 1
      MENUITEM "50%",                           IDM_VIDEO_SCANLINE_BASE + 2
      MENUITEM "75%",                           IDM_VIDEO_SCANLINE_BASE + 3
      MENUITEM "100%",                          IDM_VIDEO_SCANLINE_BASE + 4
    END
    POPUP "&NTSC Filter"
    BEGIN
      MENUITEM "Off",                           IDM_VIDEO_NTSC_BASE + 0
      MENUITEM "Composite",                     IDM_VIDEO_NTSC_BASE + 1
      MENUITEM "S-Video",                       IDM_VIDEO_NTSC_BASE + 2
      MENUITEM "RGB",                           IDM_VIDEO_NTSC_BASE + 3
    END
    POPUP "As&pect Ratio"
    BEGIN
      MENUITEM "Original Console Pixels",        IDM_VIDEO_ASPECT_BASE + 0
      MENUITEM "1:1 (Square Pixels)",           IDM_VIDEO_ASPECT_BASE + 1
      MENUITEM "4:3 (Standard)",                  IDM_VIDEO_ASPECT_BASE + 2
      MENUITEM "16:9 (Widescreen)",             IDM_VIDEO_ASPECT_BASE + 3
    END
    POPUP "&Borders"
    BEGIN
      MENUITEM "Hide All",                      IDM_VIDEO_OVERSCAN_BASE + 0
      MENUITEM "Top and Bottom",                IDM_VIDEO_OVERSCAN_BASE + 1
      MENUITEM "Left and Right",                IDM_VIDEO_OVERSCAN_BASE + 2
      MENUITEM "Show All",                      IDM_VIDEO_OVERSCAN_BASE + 3
    END
    POPUP "&Interlaced Mode"
    BEGIN
      MENUITEM "Single Field",                  IDM_VIDEO_INTERLACE_BASE + 0
      MENUITEM "Double Field",                  IDM_VIDEO_INTERLACE_BASE + 1
    END
    POPUP "Frames&kip"
    BEGIN
      MENUITEM "Off",                           IDM_VIDEO_FRAMESKIP_BASE + 0
      MENUITEM "Auto",                          IDM_VIDEO_FRAMESKIP_BASE + 1
      MENUITEM "Manual (Below 25% Audio Buffer)", IDM_VIDEO_FRAMESKIP_BASE + 2
      MENUITEM "Manual (Below 33% Audio Buffer)", IDM_VIDEO_FRAMESKIP_BASE + 3
      MENUITEM "Manual (Below 50% Audio Buffer)", IDM_VIDEO_FRAMESKIP_BASE + 4
      MENUITEM "Manual (Below 75% Audio Buffer)", IDM_VIDEO_FRAMESKIP_BASE + 5
    END
    MENUITEM SEPARATOR
    POPUP "&Renderer"
    BEGIN
      MENUITEM "GDI (Software)",                  IDM_VIDEO_RENDERER_BASE + 0
      MENUITEM "Direct3D 9",                      IDM_VIDEO_RENDERER_BASE + 1
      MENUITEM "Direct3D 11",                     IDM_VIDEO_RENDERER_BASE + 2
    END
    MENUITEM "&VSync",                            IDM_VIDEO_VSYNC
    MENUITEM "Start ROM in F&ullscreen",        IDM_VIDEO_FULLSCREEN_START
  END

  POPUP "&Audio"
  BEGIN
    POPUP "&Mute"
    BEGIN
      MENUITEM "&All Sound",                    IDM_AUDIO_ENABLE
      MENUITEM "&FM Sound",                     IDM_AUDIO_MUTE_FM
      MENUITEM "&PSG Sound",                    IDM_AUDIO_MUTE_PSG
      MENUITEM "P&WM Sound",                    IDM_AUDIO_MUTE_PWM
    END
    POPUP "Console &Model"
    BEGIN
      MENUITEM "&Default",                      IDM_SET_MODEL_BASE + 0
      MENUITEM SEPARATOR
      MENUITEM "Genesis Model &1 (Duller)",     IDM_SET_MODEL_BASE + 1
      MENUITEM "Genesis Model &2 (Cleaner)",    IDM_SET_MODEL_BASE + 2
    END
    POPUP "Tone and &Effects"
    BEGIN
      MENUITEM "High-Quality &PSG Resampling",  IDM_AUDIO_HQPSG
      MENUITEM SEPARATOR
      MENUITEM "&Low-Pass Filter",              IDM_AUDIO_LOWPASS
      MENUITEM "3-Band E&Q",                    IDM_AUDIO_EQ
      MENUITEM SEPARATOR
      MENUITEM "&Mono Output",                  IDM_AUDIO_MONO
      POPUP "&Stereo Width"
      BEGIN
        MENUITEM "Narrow (50%)",                IDM_SET_STEREO_BASE + 0
        MENUITEM "Normal (100%)",               IDM_SET_STEREO_BASE + 1
        MENUITEM "Wide (150%)",                 IDM_SET_STEREO_BASE + 2
        MENUITEM "Extra Wide (200%)",           IDM_SET_STEREO_BASE + 3
      END
      POPUP "&Bass Boost"
      BEGIN
        MENUITEM "Off",                         IDM_SET_BASS_BASE + 0
        MENUITEM "Light",                       IDM_SET_BASS_BASE + 1
        MENUITEM "Medium",                      IDM_SET_BASS_BASE + 2
        MENUITEM "Strong",                      IDM_SET_BASS_BASE + 3
      END
      MENUITEM SEPARATOR
      MENUITEM "&Overdrive",                    IDM_OPT_OVERDRIVE
      MENUITEM "&Even Out Loudness",            IDM_OPT_NORMALIZE
    END
    MENUITEM SEPARATOR
    MENUITEM "&Levels and Latency...",          IDM_AUDIO_SETTINGS
  END

  POPUP "&Input"
  BEGIN
    MENUITEM "&Controls...",                    IDM_INPUT_P1
    MENUITEM "&Hotkeys...",                     IDM_INPUT_HOTKEYS
    MENUITEM SEPARATOR
    MENUITEM "Enable Bac&kground Input",         IDM_INPUT_BACKGROUND
  END

  POPUP "&Tools"
  BEGIN
    MENUITEM "&Cheats...\tCtrl+C",              IDM_EMU_CHEATS
    MENUITEM "Cheat Searc&h...",                IDM_EMU_CHEATSEARCH
    MENUITEM SEPARATOR
    MENUITEM "&Netplay...",               IDM_TOOLS_NETPLAY
    MENUITEM "Sto&p Netplay",                   IDM_TOOLS_NETPLAY_STOP
    MENUITEM SEPARATOR
    POPUP "&Record"
    BEGIN
      MENUITEM "Record Animated &GIF\tCtrl+F12",    IDM_FILE_REC_GIF
      MENUITEM "Record &Video + Audio\tShift+F11",  IDM_FILE_REC_VIDEO
      MENUITEM "Record &Audio Only\tCtrl+F11",      IDM_FILE_REC_AUDIO
      MENUITEM "Record &VGM File",                IDM_TOOLS_VGM
      MENUITEM SEPARATOR
      MENUITEM "&Stop Recording\tAlt+F11",           IDM_FILE_REC_STOP
      MENUITEM SEPARATOR
      MENUITEM "Record &Input...",                IDM_TOOLS_MOVIE_REC
      MENUITEM "&Play Input Recording...",        IDM_TOOLS_MOVIE_PLAY
      MENUITEM "Stop Input Recording / Playbac&k", IDM_TOOLS_MOVIE_STOP
    END
    MENUITEM "&Save Screenshot\tF12",           IDM_FILE_SCREENSHOT
  END

  POPUP "&Options"
  BEGIN
    MENUITEM "&Settings...",                    IDM_OPTIONS_SETTINGS
    MENUITEM SEPARATOR
    POPUP "Re&gion"
    BEGIN
      MENUITEM "Detect from ROM",               IDM_EMU_REGION_BASE + 0
      MENUITEM "USA",                           IDM_EMU_REGION_BASE + 1
      MENUITEM "Europe",                        IDM_EMU_REGION_BASE + 2
      MENUITEM "Japan (NTSC)",                  IDM_EMU_REGION_BASE + 3
      MENUITEM "Japan (PAL)",                   IDM_EMU_REGION_BASE + 4
    END
    POPUP "Force &VDP Mode"
    BEGIN
      MENUITEM "Auto",                          IDM_EMU_VDPMODE_BASE + 0
      MENUITEM "NTSC (60 Hz)",                  IDM_EMU_VDPMODE_BASE + 1
      MENUITEM "PAL (50 Hz)",                   IDM_EMU_VDPMODE_BASE + 2
    END
    POPUP "&Console"
    BEGIN
      MENUITEM "Detect from ROM",               IDM_EMU_SYSTEM_BASE + 0
      MENUITEM SEPARATOR
      MENUITEM "SG-1000",                       IDM_EMU_SYSTEM_BASE + 1
      MENUITEM "SG-1000 II",                    IDM_EMU_SYSTEM_BASE + 2
      MENUITEM "SG-1000 II + RAM Adapter",      IDM_EMU_SYSTEM_BASE + 3
      MENUITEM "Mark III",                      IDM_EMU_SYSTEM_BASE + 4
      MENUITEM "Master System",                 IDM_EMU_SYSTEM_BASE + 5
      MENUITEM "Master System II",              IDM_EMU_SYSTEM_BASE + 6
      MENUITEM "Game Gear",                     IDM_EMU_SYSTEM_BASE + 7
      MENUITEM "Mega Drive / Genesis",          IDM_EMU_SYSTEM_BASE + 8
    END
  END

  POPUP "&Help"
  BEGIN
    MENUITEM "&Keyboard Shortcuts\tF1",         IDM_HELP_SHORTCUTS
    MENUITEM "&User Guide",                       IDM_HELP_MENUGUIDE
    MENUITEM "&About Genesis Plus EX",          IDM_HELP_ABOUT
  END
END

/****************************************************************************
 * Accelerators
 *
 * Nothing here may collide with the default gamepad keys (arrows, A S D F,
 * Z X C V) or the key would be swallowed before the emulator sees it.
 ****************************************************************************/

IDR_ACCELERATORS ACCELERATORS
BEGIN
  "O",          IDM_FILE_OPEN,              VIRTKEY, CONTROL
  "B",          IDM_FILE_BROWSER,           VIRTKEY, CONTROL
  "R",          IDM_EMU_RESET,              VIRTKEY, CONTROL
  "R",          IDM_EMU_HARDRESET,          VIRTKEY, CONTROL, SHIFT
  "C",          IDM_EMU_CHEATS,             VIRTKEY, CONTROL
  "F",          IDM_VIEW_FINDSEARCH,        VIRTKEY, CONTROL
  VK_F9,        IDM_EMU_UNDOLOAD,           VIRTKEY
  VK_F1,        IDM_HELP_SHORTCUTS,         VIRTKEY
  VK_F2,        IDM_EMU_PAUSE,              VIRTKEY
  VK_PAUSE,     IDM_EMU_PAUSE,              VIRTKEY
  VK_F3,        IDM_EMU_STOP,               VIRTKEY
  VK_F5,        IDM_ACCEL_QUICKSAVE,        VIRTKEY
  VK_F6,        IDM_ACCEL_SLOT_PREV,        VIRTKEY
  VK_F7,        IDM_ACCEL_SLOT_NEXT,        VIRTKEY
  VK_F8,        IDM_ACCEL_QUICKLOAD,        VIRTKEY
  VK_F11,       IDM_FILE_REC_VIDEO,         VIRTKEY, SHIFT
  VK_F11,       IDM_FILE_REC_AUDIO,         VIRTKEY, CONTROL
  VK_F11,       IDM_FILE_REC_STOP,          VIRTKEY, ALT
  VK_F12,       IDM_FILE_SCREENSHOT,        VIRTKEY
  VK_RETURN,    IDM_VIDEO_FULLSCREEN,       VIRTKEY, ALT
  VK_ESCAPE,    IDM_ACCEL_LEAVE_FULLSCREEN, VIRTKEY
END

/****************************************************************************
 * Dialogs
 ****************************************************************************/

IDD_ABOUT DIALOGEX 0, 0, 340, 206
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Genesis Plus EX"
FONT 8, "MS Shell Dlg"
BEGIN
  ICON            IDI_APPICON, IDC_ABOUT_ICON, 12, 14, 20, 20
  LTEXT           "", IDC_ABOUT_TEXT, 48, 12, 280, 116
  CONTROL         "", IDC_ABOUT_LINK1, "SysLink", WS_TABSTOP, 48, 134, 280, 10
  DEFPUSHBUTTON   "Close", IDOK, 280, 182, 48, 16
END

IDD_STATEMGR DIALOGEX 0, 0, 548, 258
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manage Save States"
FONT 8, "MS Shell Dlg"
BEGIN
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 0, 8, 8, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 0 (Empty)", IDC_STATEMGR_LABEL_BASE + 0, 8, 79, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 1, 114, 8, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 1 (Empty)", IDC_STATEMGR_LABEL_BASE + 1, 114, 79, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 2, 220, 8, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 2 (Empty)", IDC_STATEMGR_LABEL_BASE + 2, 220, 79, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 3, 326, 8, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 3 (Empty)", IDC_STATEMGR_LABEL_BASE + 3, 326, 79, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 4, 432, 8, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 4 (Empty)", IDC_STATEMGR_LABEL_BASE + 4, 432, 79, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 5, 8, 116, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 5 (Empty)", IDC_STATEMGR_LABEL_BASE + 5, 8, 187, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 6, 114, 116, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 6 (Empty)", IDC_STATEMGR_LABEL_BASE + 6, 114, 187, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 7, 220, 116, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 7 (Empty)", IDC_STATEMGR_LABEL_BASE + 7, 220, 187, 100, 28, SS_CENTER
  PUSHBUTTON      "", IDC_STATEMGR_SLOT_BASE + 8, 326, 116, 100, 69, BS_BITMAP | BS_NOTIFY
  LTEXT           "Slot 8 (Empty)", IDC_STATEMGR_LABEL_BASE + 8, 326, 187, 100, 28, SS_CENTER
