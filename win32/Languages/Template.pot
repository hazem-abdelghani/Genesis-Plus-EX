#: d3d11_video.c:52
msgid "struct VSIn  { float2 pos : POSITION; float2 uv : TEXCOORD0; };\nstruct VSOut { float4 pos : SV_POSITION; float2 uv : TEXCOORD0; };\nVSOut main(VSIn i)\n{\n  VSOut o;\n  o.pos = float4(i.pos, 0.0, 1.0);\n  o.uv = i.uv;\n  return o;\n}\n"
msgstr ""

#: d3d11_video.c:63
msgid "Texture2D    tex0 : register(t0);\nSamplerState samp0 : register(s0);\nstruct VSOut { float4 pos : SV_POSITION; float2 uv : TEXCOORD0; };\nfloat4 main(VSOut i) : SV_TARGET\n{\n  return tex0.Sample(samp0, i.uv);\n}\n"
msgstr ""

#: d3d11_video.c:80
msgid "Texture2D tex0 : register(t0);"
msgstr ""

#: d3d11_video.c:80
msgid "SamplerState samp0 : register(s0);"
msgstr ""

#: d3d11_video.c:80
msgid "struct VSOut { float4 pos : SV_POSITION; float2 uv : TEXCOORD0; };"
msgstr ""

#: d3d11_video.c:80
msgid "float4 main_catmull(VSOut i) : SV_TARGET"
msgstr ""

#: d3d11_video.c:80
msgid "  uint tw, th; tex0.GetDimensions(tw, th);"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 dims = float2(tw, th);"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 sp = i.uv * dims;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 t1 = floor(sp - 0.5) + 0.5;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 f = sp - t1;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 w3 = f * f * (-0.5 + 0.5 * f);"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 w12 = w1 + w2;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 o12 = w2 / w12;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 t0 = (t1 - 1.0) / dims;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 t3 = (t1 + 2.0) / dims;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 t12 = (t1 + o12) / dims;"
msgstr ""

#: d3d11_video.c:80
msgid "  float4 r = tex0.Sample(samp0, float2(t0.x, t0.y)) * (w0.x * w0.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t12.x, t0.y)) * (w12.x * w0.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t3.x, t0.y)) * (w3.x * w0.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t0.x, t12.y)) * (w0.x * w12.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t12.x, t12.y)) * (w12.x * w12.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t3.x, t12.y)) * (w3.x * w12.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t0.x, t3.y)) * (w0.x * w3.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t12.x, t3.y)) * (w12.x * w3.y)"
msgstr ""

#: d3d11_video.c:80
msgid "           + tex0.Sample(samp0, float2(t3.x, t3.y)) * (w3.x * w3.y);"
msgstr ""

#: d3d11_video.c:80
msgid "  return r;"
msgstr ""

#: d3d11_video.c:80
msgid "float4 main_sharpbil(VSOut i) : SV_TARGET"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 p = i.uv * dims + 0.5;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 fl = floor(p);"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 f = p - fl;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 uvn = (fl + f - 0.5) / dims;"
msgstr ""

#: d3d11_video.c:80
msgid "  return tex0.Sample(samp0, uvn);"
msgstr ""

#: d3d11_video.c:80
msgid "float4 main_sharpnear(VSOut i) : SV_TARGET"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 fp = max(float2(abs(ddx(i.uv.x)), abs(ddy(i.uv.y))) * dims, 0.0001);"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 k = max(1.0 / fp, float2(1.0, 1.0));"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 p = i.uv * dims;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 cd = p - fl - 0.5;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 rr = 0.5 - 0.5 / k;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 f = (cd - clamp(cd, -rr, rr)) * k + 0.5;"
msgstr ""

#: d3d11_video.c:80
msgid "  float2 uvn = (fl + f) / dims;"
msgstr ""

