#: d3d12_video.c:56
msgid "cbuffer C : register(b0) { float4 rect; float lin; float3 pad; };"
msgstr ""

#: d3d12_video.c:56
msgid "VSOut main(uint id : SV_VertexID)"
msgstr ""

#: d3d12_video.c:56
msgid "  float2 uv = float2((float)(id & 1u), (float)(id >> 1u));"
msgstr ""

#: d3d12_video.c:56
msgid "  VSOut o;"
msgstr ""

#: d3d12_video.c:56
msgid "  o.pos = float4(lerp(rect.x, rect.z, uv.x), lerp(rect.y, rect.w, uv.y), 0.0, 1.0);"
msgstr ""

#: d3d12_video.c:56
msgid "  o.uv = uv;"
msgstr ""

#: d3d12_video.c:56
msgid "  return o;"
msgstr ""

#: d3d12_video.c:68
msgid "SamplerState sPoint : register(s0);"
msgstr ""

#: d3d12_video.c:68
msgid "SamplerState sLin : register(s1);"
msgstr ""

#: d3d12_video.c:68
msgid "float4 main(VSOut i) : SV_TARGET"
msgstr ""

#: d3d12_video.c:68
msgid "  float4 a = tex0.Sample(sPoint, i.uv);"
msgstr ""

#: d3d12_video.c:68
msgid "  float4 b = tex0.Sample(sLin, i.uv);"
msgstr ""

#: d3d12_video.c:68
msgid "  return lin > 0.5 ? b : a;"
msgstr ""

#: d3d12_video.c:84
msgid "SamplerState samp0 : register(s1);"
msgstr ""

#: d3d9_video.c:82
msgid "sampler2D s0 : register(s0);"
msgstr ""

#: d3d9_video.c:82
msgid "float4 dims : register(c0);"
msgstr ""

#: d3d9_video.c:82
msgid "float4 main_catmull(float2 uv : TEXCOORD0) : COLOR"
msgstr ""

#: d3d9_video.c:82
msgid "  float2 sp = uv * dims.xy;"
msgstr ""

#: d3d9_video.c:82
msgid "  float2 t0 = (t1 - 1.0) * dims.zw;"
msgstr ""

#: d3d9_video.c:82
msgid "  float2 t3 = (t1 + 2.0) * dims.zw;"
msgstr ""

#: d3d9_video.c:82
msgid "  float2 t12 = (t1 + o12) * dims.zw;"
msgstr ""

#: d3d9_video.c:82
msgid "  float4 r = tex2D(s0, float2(t0.x, t0.y)) * (w0.x * w0.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t12.x, t0.y)) * (w12.x * w0.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t3.x, t0.y)) * (w3.x * w0.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t0.x, t12.y)) * (w0.x * w12.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t12.x, t12.y)) * (w12.x * w12.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t3.x, t12.y)) * (w3.x * w12.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t0.x, t3.y)) * (w0.x * w3.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t12.x, t3.y)) * (w12.x * w3.y)"
msgstr ""

#: d3d9_video.c:82
msgid "           + tex2D(s0, float2(t3.x, t3.y)) * (w3.x * w3.y);"
msgstr ""

#: d3d9_video.c:82
msgid "float4 main_sharpbil(float2 uv : TEXCOORD0) : COLOR"
msgstr ""

#: d3d9_video.c:82
msgid "  float2 p = uv * dims.xy + 0.5;"
msgstr ""

#: d3d9_video.c:82
msgid "  return tex2D(s0, (fl + f - 0.5) * dims.zw);"
msgstr ""

